                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Booking Endpoint With No Auth (401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightInstanceId\": {{flightInstanceId}},\n  \"passengers\": [\n    { \"name\": \"Alice\", \"seatLabel\": \"1A\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings"]
            },
            "description": "No token at all on a protected booking endpoint."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Error Cases",
      "auth": {
        "type": "bearer",
        "bearer": [
          { "key": "token", "value": "{{clientToken}}", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "Create Booking - Duplicate Seat In Request (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightInstanceId\": {{flightInstanceId}},\n  \"passengers\": [\n    { \"name\": \"Alice\", \"seatLabel\": \"2A\" },\n    { \"name\": \"Bob\", \"seatLabel\": \"2A\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings"]
            },
            "description": "Same seat label requested twice within one booking - rejected as a malformed request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Create Booking - Unknown Seat Label (400)",
          "request": {
            "method": "POST",
            "header": [
